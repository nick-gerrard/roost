# roost-managed
[Unit]
Description={{ name }} API (roost)
After=network.target postgresql.service

[Service]
User={{ user }}
WorkingDirectory={{ app_dir }}/{{ backend.workdir }}
EnvironmentFile=-{{ env_file }}
{% for k, v in env.items() %}
Environment={{ k }}={{ v }}
{% endfor %}
ExecStart={{ exec_dir }}/{{ start }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
