# roost-managed
[Unit]
Description={{ name }} API (roost)
After=network.target postgresql.service

[Service]
{% if backend.sandbox %}
# sandbox: a throwaway user that sees only its own (read-only) code and /var/lib/{{ name }}
DynamicUser=yes
StateDirectory={{ name }}
ProtectHome=tmpfs
BindReadOnlyPaths={{ app_dir }} -{{ uv_python_dir }}
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=127.0.0.53
IPAddressDeny=localhost
MemoryMax=300M
{% else %}
User={{ user }}
{% endif %}
WorkingDirectory={{ app_dir }}/{{ backend.workdir }}
EnvironmentFile=-{{ env_file }}
{% for k, v in env.items() %}
Environment={{ k }}={{ v }}
{% endfor %}
ExecStart={{ exec_dir }}/{{ start }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
